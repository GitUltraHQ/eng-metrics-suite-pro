# Copy this file to .env and fill in what you need, then `docker compose up`.
# docker compose reads .env automatically -- no need to source it yourself.

# Postgres password used by every service (default: changeme, please change it).
# Only relevant if you're using the bundled Postgres container below --
# see DATABASE_URL if you're pointing at your own instead.
POSTGRES_PASSWORD=changeme

# Leave unset to use the bundled Postgres container (default). Set this
# to point every service at your own managed Postgres instead (RDS,
# Cloud SQL, Azure Database for PostgreSQL, or any other standard
# Postgres 12+ instance) -- postgres://user:pass@host:port/dbname.
# Most managed providers need `?sslmode=require` (or their own
# equivalent) appended. See docs.gitultra.com's Getting Started page,
# "Using an external database", for how to also stop running the
# bundled container once you've set this.
DATABASE_URL=

# INFO (default), DEBUG, WARNING, or ERROR. Controls verbosity of the
# structured JSON logs on stdout (see `docker compose logs`).
LOG_LEVEL=INFO

# Each service sends an anonymous usage heartbeat (no repo names, code,
# or personal data -- see eng-metrics-docs' Telemetry page for exactly
# what's sent). Set to 1 to disable.
TELEMETRY_DISABLED=

# Leave unset -- works out of the box with the built-in default. Only
# set this if you have a specific reason to rotate it (not a real secret,
# just a filter against naive automated traffic against a public endpoint).
TELEMETRY_SHARED_SECRET=

# Only set the credentials for the vendor(s) you're actually importing from.
# git-processor and pr-processor each only use the ones matching the repos
# you've queued.
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_SERVER_USERNAME=
BITBUCKET_SERVER_TOKEN=
AZURE_DEVOPS_PAT=

# --- issue-processor (optional) ---
# Only needed if you're using at least one of the two Jira-backed
# features below. Free-tier infrastructure feeding eng-api's paid
# endpoints (change-failure-rate/MTTR) below -- not gated by
# GITULTRA_LICENSE_KEY itself. Shared auth for both features.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Change failure rate / MTTR: links Jira incidents to deployments via
# Fix Version. See jira_project_map.yaml. Comma-separated Jira
# issue-type names that count as an "incident", e.g. Incident,Bug --
# required if you want this feature (leave blank to skip it entirely).
JIRA_INCIDENT_ISSUE_TYPES=

# Investment allocation report: categorizes and tracks Jira work items.
# See allocation_projects.yaml. Comma-separated Jira issue-type names
# that count as "work" for this report, e.g. Story,Task,Bug -- required
# if you want this feature (leave blank to skip it entirely).
JIRA_ALLOCATION_ISSUE_TYPES=
# Custom field ID holding each issue's category (e.g. customfield_10032).
# Optional -- if unset, every issue's category is its Jira issue type.
JIRA_CATEGORY_FIELD=
# Custom field ID holding story points (varies per Jira instance, no
# universal default -- commonly but not always customfield_10016).
# Optional -- if unset, story-point views in the report show "n/a".
JIRA_STORY_POINTS_FIELD=

# --- eng-api (paid tier) ---

# Required. A secret YOU choose (e.g. `openssl rand -hex 32`) -- this is
# not issued or stored by us, it's just what your own dashboards send
# back as Authorization: Bearer <this value>. See eng-api's README.
ENG_API_KEY=

# Required. Your signed license key -- issued to you directly (contact
# support@gitultra.com), not something you generate yourself. Valid for
# 90 days; a renewal is just a fresh key requested the same way. See
# eng-api's README's "Distribution" section for what this does and
# doesn't protect against.
GITULTRA_LICENSE_KEY=

# Which host port eng-api's REST API listens on.
ENG_API_PORT=8000

# Optional. eng-api already mounts /var/lib/eng-metrics-suite read-only
# (same as eng-reports above) -- drop a team-map CSV (email,team header)
# there, e.g. /var/lib/eng-metrics-suite/teams.csv, and set this to that
# in-container path. Leave blank to disable the `team` query parameter
# and team_rollup response fields.
ENG_API_TEAM_MAP_PATH=

# Optional overrides -- see eng-api's README. Leave blank to use the
# bundled defaults.
ENG_API_AI_COAUTHORS_PATH=
ENG_API_TAG_PATTERN=

# --- gitultra-mcp (paid tier) ---
# MCP server letting an AI agent (Claude Desktop, Claude Code, etc.)
# query the metrics above conversationally. Pure HTTP proxy to eng-api
# above -- reuses ENG_API_KEY and GITULTRA_LICENSE_KEY from that section
# (a single license key can cover both "eng-api" and "gitultra-mcp"),
# nothing new to set there. See gitultra-mcp's README for how to point
# a Claude Desktop/Code config at this.

# Which host port gitultra-mcp's streamable-HTTP endpoint listens on.
GITULTRA_MCP_PORT=8100
